# Neon Postgres (Vercel Marketplace adds this automatically)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Yahoo app from https://developer.yahoo.com/apps/ (Fantasy Sports: Read; later Read/Write)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must exactly match the redirect URI registered with Yahoo (Yahoo requires https)
YAHOO_REDIRECT_URI=https://your-app.vercel.app/api/auth/yahoo/callback

# Only this Yahoo account may sign in. Leave empty for first setup: the first account
# to sign in becomes the owner, and nobody else can sign in after that.
ALLOWED_YAHOO_GUID=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Shared secret GitHub Actions sends to /api/jobs/*. Generate with: openssl rand -hex 24
JOB_TOKEN=

# Optional fallback NBA data source
BALLDONTLIE_API_KEY=

# Time zone used for "today" and game days
APP_TIMEZONE=America/New_York

# Optional: password sign-in (single owner), for using the app without Yahoo Fantasy API access.
APP_PASSWORD=
